# TissueLab (open edition) — service configuration.
# Copy to .env.local (gitignored). Every value is optional.
#
# Installed desktop app: put the same file at <service root>/.env.local, i.e.
#   Windows  %APPDATA%\TissueLab\.env.local
#   macOS    ~/Library/Application Support/TissueLab/.env.local

ENVIRONMENT=local

# Storage root (storage/uploads, model registry, logs). Defaults to app/service.
# The Electron app overrides this with --service-root <app data dir>.
# TL_SERVICE_ROOT=/absolute/path

# Interface to bind. Keep 127.0.0.1 unless you understand the consequences:
# the service performs no authentication.
TL_HOST=127.0.0.1

# LLM agent (planning / chat / code generation). Leave empty to disable the agent;
# the viewer, segmentation, classifiers and installed workflows still work.
OPENAI_API_KEY=
# Any OpenAI-compatible server works (vLLM, Ollama, LM Studio, llama.cpp, LiteLLM, ...):
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:32b            # model name on that server (shared default for every role)
# LLM_API=chat                   # chat (Chat Completions, default for self-hosted) | responses (OpenAI)
# Per-role overrides (default: LLM_MODEL, or gpt-5.2 on OpenAI):
# WORKFLOW_MODEL=  CHAT_MODEL=  CODE_MODEL=  RANKING_MODEL=  OPENAI_MODEL_ROUTER=  OPENAI_VISION_MODEL=

# Optional extra read-only data root shown as the virtual folder samples/Data.
# PUBLIC_DATA_PATH=/data/public

# Public host for task node bundles (catalog + archives).
TL_BUNDLE_BASE_URL=https://storage.googleapis.com/tissuelab-2025.firebasestorage.app

# Sandboxed code execution: auto = Docker when available, else in-process subprocess.
CODEEXEC_DOCKER=auto
CODEEXEC_MAX_CONCURRENCY=1

# Start installed task nodes on boot.
AUTO_ACTIVATE_TASKNODES=true

# Windows only: unpacked vips-dev-w64-all directory (full libvips with the
# OpenSlide/JPEG-2000/HEIF/JXL loaders). Unset = vendor/ (scripts/fetch_libvips.py) or PATH.
# TL_VIPS_DIR=D:/tools/vips-dev-8.17
